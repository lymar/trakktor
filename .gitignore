# Rust / Cargo
/target/
**/*.rs.bk
*.pdb

# Local scratch and sample media (developer-local, not part of the project)
/tmp/

# trakktor working directory: per-project local state (feed read-state).
# Created at runtime, never part of the project. Model weights live under the
# model directory (~/.trakktor by default), outside the project tree.
.trakktor/

# Claude Code runtime artifacts (the scheduled-tasks lock is per-process state,
# not project content; tracked skills under .claude/ are kept).
.claude/scheduled_tasks.lock

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
